PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# XAMPP MySQL defaults: user root, empty password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cyberacademy

# IP address of the machine running the platform, as seen from the Kali VM.
# Shown to users on lab pages so they know where to connect.
LAB_HOST=192.168.56.1
